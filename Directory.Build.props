<Project>
  <PropertyGroup>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <Product>GlassPlayer</Product>
    <Company>N3moStudio</Company>
    <Authors>Jonzu00; N3moStudio</Authors>
    <Description>GlassPlayer community fork with native Windows ARM64 support</Description>
    <Copyright>Original GlassPlayer by Jonzu00. Fork modifications by N3moStudio.</Copyright>
    <RepositoryUrl>https://github.com/N3moStudio/GlassPlayer</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
  </PropertyGroup>
</Project>
